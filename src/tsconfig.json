{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "composite": true,
    "module": "CommonJS",
    "target": "ES2022",
    "outDir": "../out",
    "lib": ["ES2022"],
    "sourceMap": true,
    "rootDir": ".",
    "baseUrl": ".",
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./*"],
      "@shared/*": ["../shared/*"]
    }
  },
  "references": [{ "path": "../shared" }],
  "include": ["./**/*", "package.json"],
  "exclude": ["node_modules", "out", "dist", "webview-ui"]
}
