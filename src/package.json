{
  "name": "dish-ai-commit",
  "displayName": "Dish AI Commit Message Gen",
  "description": "🤖 AI-Powered VSCode extension for generating standardized Git/SVN commit messages. ✨ Supports 20+ AI services: OpenAI, Ollama, VS Code AI, Zhipu AI, DashScope, Doubao AI, Gemini, Deepseek, Anthropic, Mistral, Azure OpenAI, VertexAI, LMStudio and more. 🌍 19 languages supported. 📊 Features: AI commit generation, code review, weekly reports, branch naming, PR summaries, token statistics.",
  "version": "0.55.7",
  "engines": {
    "node": ">= 18.20.8",
    "pnpm": ">= 10.0.0",
    "vscode": "^1.90.0"
  },
  "publisher": "littleCareless",
  "repository": "https://github.com/littleCareless/dish-ai-commit",
  "icon": "images/logo.png",
  "categories": [
    "SCM Providers",
    "Machine Learning",
    "Snippets",
    "Formatters",
    "AI",
    "Other"
  ],
  "keywords": [
    "OpenAI",
    "ChatGPT",
    "Ollama",
    "Vscode",
    "GitEmoji",
    "SvnEmoji",
    "Git Commit",
    "Svn Commit",
    "Conventional Commits",
    "Commitizen",
    "Commit Message",
    "Commit Message Generator",
    "AI Commit",
    "Auto Commit",
    "SCM Providers",
    "SCM",
    "Dish Ai Commit",
    "Zhipu AI",
    "DashScope",
    "Doubao AI",
    "Gemini",
    "Deepseek",
    "siliconflow"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:dish-ai-commit",
    "onView:dish-ai-commit.settingsView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dish-ai-commitActivityBar",
          "title": "Dish Ai Commit Message",
          "icon": "/images/menu-icon.svg"
        }
      ]
    },
    "views": {
      "dish-ai-commitActivityBar": [
        {
          "id": "dish-ai-commit.settingsView",
          "name": "Plugin Settings",
          "type": "webview",
          "contextualTitle": "Dish Ai Commit Message Settings",
          "icon": "/images/menu-icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "dish-ai-commit.generateCommitMessage",
        "title": "%extension.contributes.commands.dish-ai-commit.generateCommitMessage.title%",
        "category": "%extension.contributes.commands.dish-ai-commit.generateCommitMessage.category%",
        "icon": {
          "light": "images/icon.svg",
          "dark": "images/icon.svg"
        },
        "description": "%extension.contributes.commands.dish-ai-commit.generateCommitMessage.description%"
      },
      {
        "command": "dish-ai-commit.generateWeeklyReport",
        "title": "%extension.contributes.commands.dish-ai-commit.generateWeeklyReport.title%",
        "category": "%extension.contributes.commands.dish-ai-commit.generateWeeklyReport.category%",
        "icon": {
          "light": "images/light/chart-bar.svg",
          "dark": "images/dark/chart-bar.svg"
        },
        "description": "%extension.contributes.commands.dish-ai-commit.generateWeeklyReport.description%"
      },
      {
        "command": "dish-ai-commit.reviewCode",
        "title": "%extension.contributes.commands.dish-ai-commit.reviewCode.title%",
        "category": "%extension.contributes.commands.dish-ai-commit.reviewCode.category%",
        "icon": {
          "light": "images/light/clipboard-check.svg",
          "dark": "images/dark/clipboard-check.svg"
        },
        "description": "%extension.contributes.commands.dish-ai-commit.reviewCode.description%"
      },
      {
        "command": "dish-ai-commit.generateBranchName",
        "title": "%extension.contributes.commands.dish-ai-commit.generateBranchName.title%",
        "category": "%extension.contributes.commands.dish-ai-commit.generateBranchName.category%",
        "icon": {
          "light": "images/light/git-branch.svg",
          "dark": "images/dark/git-branch.svg"
        },
        "description": "%extension.contributes.commands.dish-ai-commit.generateBranchName.description%"
      },
      {
        "command": "dish-ai-commit.generatePRSummary",
        "title": "%extension.contributes.commands.dish-ai-commit.generatePRSummary.title%",
        "category": "%extension.contributes.commands.dish-ai-commit.generatePRSummary.category%",
        "icon": {
          "light": "images/light/git-pull-request.svg",
          "dark": "images/dark/git-pull-request.svg"
        },
        "description": "%extension.contributes.commands.dish-ai-commit.generatePRSummary.description%"
      }
    ],
