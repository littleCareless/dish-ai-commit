# Ignore everything by default
*

# Whitelist files to include
!package.json
!package.nls*.json
!README.md
!CHANGELOG.md
!CHANGELOG.zh-CN.md
!LICENSE
!SECURITY.md

# Whitelist directories to include
!dist/**
!i18n/**
!images/**

# Explicitly ignore development configs (just in case they were matched by whitelist)
tsconfig.json
esbuild.mjs
vite.config.ts
eslint.config.js
.eslintrc.json
.vscodeignore
.gitignore
.npmrc
.versionrc
turbo.json

# Ignore source directories (redundant due to *, but for clarity)
ai/
commands/
services/
scm/
utils/
scripts/
test/
__tests__/
config/
core/
prompt/
types/
webview/
webview-ui/
docs/
.turbo/
out/