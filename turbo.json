{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": ["dist/**", "out/**"]
    },
    "lint": {},
    "check-types": {},
    "test": {},
    "format": {},
    "clean": {
      "cache": false
    },
    "compile": {
      "outputs": ["out/**", "dist/**"]
    },
    "compile:webview": {
      "outputs": ["webview-ui/dist/**"]
    },
    "package": {
      "outputs": ["*.vsix"]
    },
    "vsix": {
      "outputs": ["*.vsix"]
    },
    "publish": {},
    "quality-gate": {
      "dependsOn": ["test", "lint", "check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "watch": {
      "cache": false,
      "persistent": true
    },
    "watch:tsc": {
      "cache": false,
      "persistent": true
    },
    "watch:bundle": {
      "cache": false,
      "persistent": true
    }
  }
}
