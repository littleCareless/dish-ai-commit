{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/src",
        "--disable-extensions"
      ],
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/src/dist/**/*.js"],
      "preLaunchTask": "${defaultBuildTask}",
      "env": {
        "NODE_ENV": "development",
        "VSCODE_DEBUG_MODE": "true"
      },
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "presentation": {
        "hidden": false,
        "group": "tasks",
        "order": 1
      }
    },
    {
      "name": "Run Extension (Debug Mode)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/src",
        "--disable-extensions",
        "--enable-extension=vscode.git"
      ],
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/src/dist/**/*.js"],
      "preLaunchTask": "${defaultBuildTask}",
      "env": {
        "NODE_ENV": "development",
        "VSCODE_DEBUG_MODE": "true"
      },
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "presentation": {
        "hidden": false,
        "group": "tasks",
        "order": 2
      }
    }
  ]
}
