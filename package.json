{
  "name": "dish-ai-commit-workspace",
  "packageManager": "pnpm@10.29.3",
  "displayName": "Dish AI Commit Message Gen",
  "description": "🤖 由 AI 提供支持的 VSCode 扩展，用于生成标准化的 Git/SVN 提交消息 - 🤖 AI-Powered VSCode extension for generating standardized Git/SVN commit messages. ✨ Supports multiple AI services: OpenAI, ChatGPT, Ollama, Zhipu, DashScope, Doubao, Gemini and VS Code built-in AI. 🌍 Multi-language support (EN/CN/JP/KR/Other). 📊 Auto-generate weekly reports.",
  "version": "0.57.0",
  "engines": {
    "node": ">= 18.20.8",
    "pnpm": ">= 10.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "turbo lint --log-order grouped --output-logs new-only",
    "check-types": "turbo check-types --log-order grouped --output-logs new-only",
    "test": "turbo test --log-order grouped --output-logs new-only",
    "format": "turbo format --log-order grouped --output-logs new-only",
    "build": "turbo build --log-order grouped --output-logs new-only",
    "build:dev": "pnpm --filter @dish-ai-commit/webview-ui run build:dev && pnpm --filter dish-ai-commit run build:dev",
    "build:prod": "pnpm --filter @dish-ai-commit/webview-ui run build:prod && pnpm --filter dish-ai-commit run build:prod",
    "dev": "turbo dev --log-order grouped --output-logs new-only",
    "watch": "turbo watch --log-order grouped --output-logs new-only",
    "compile": "turbo compile --log-order grouped --output-logs new-only",
    "compile:webview": "turbo compile:webview --log-order grouped --output-logs new-only",
    "package": "turbo package --log-order grouped --output-logs new-only",
    "package:dev": "pnpm run build:prod && pnpm --filter dish-ai-commit run package",
    "package:prod": "pnpm run build:prod && pnpm --filter dish-ai-commit run package",
    "publish": "turbo publish --log-order grouped --output-logs new-only",
    "vsix": "turbo vsix --log-order grouped --output-logs new-only",
    "vsix:dev": "pnpm run build:dev && pnpm --filter dish-ai-commit run vsix",
    "vsix:prod": "pnpm run build:prod && pnpm --filter dish-ai-commit run vsix",
    "clean": "turbo clean --log-order grouped --output-logs new-only && rimraf dist out webview-ui/dist .turbo",
    "clean:all": "npm run clean && rimraf node_modules **/node_modules **/pnpm-lock.yaml **/package-lock.json **/yarn.lock pnpm-lock.yaml package-lock.json yarn.lock *.vsix",
    "quality-gate": "turbo quality-gate --log-order grouped --output-logs new-only",
    "release": "node release.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@commitlint/types": "^20.4.0",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@stylistic/eslint-plugin": "^5.8.0",
    "@types/jest": "^30.0.0",
    "@types/micromatch": "^4.0.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "~25.2.3",
    "@types/proper-lockfile": "^4.1.4",
    "@types/stream-json": "^1.7.8",
    "@types/vscode": "^1.109.0",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "@typescript/native-preview": "7.0.0-dev.20260214.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "4.0.18",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "~3.7.1",
    "esbuild": "^0.27.3",
    "eslint": "^10.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "only-allow": "^1.2.2",
    "ovsx": "0.10.9",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.2",
    "standard-version": "^9.5.0",
    "turbo": "^2.8.8",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "resolutions": {
    "@types/node": "^22.14.0"
  },
  "pnpm": {
    "overrides": {
      "tar-fs": ">=2.1.3",
      "esbuild": ">=0.25.0",
      "undici": ">=5.29.0",
      "brace-expansion": "2.0.2",
      "minimatch@10>brace-expansion": "^5.0.2",
      "form-data": ">=4.0.4",
      "bluebird": ">=3.7.2",
      "glob": "10.3.10"
    },
    "onlyBuiltDependencies": [
      "@vscode/vsce-sign",
      "core-js",
      "esbuild",
      "keytar",
      "protobufjs",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^4.0.60",
    "@ai-sdk/anthropic": "^3.0.44",
    "@ai-sdk/cerebras": "^2.0.33",
    "@ai-sdk/cohere": "^3.0.21",
    "@ai-sdk/deepinfra": "^2.0.34",
    "@ai-sdk/fireworks": "^2.0.34",
    "@ai-sdk/google": "^3.0.29",
    "@ai-sdk/openai": "^3.0.29",
    "ai": "^6.0.86",
    "commitlint": "^20.4.1",
    "commitlint-config-gitmoji": "^2.3.1",
    "ollama-ai-provider-v2": "^3.3.0",
    "proper-lockfile": "^4.1.2",
    "stream-json": "^1.9.1",
    "zod": "^4.3.6"
  },
  "volta": {
    "node": "20.19.6"
  }
}
