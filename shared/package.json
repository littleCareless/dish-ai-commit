{
  "name": "@dish-ai-commit/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared types and utilities for dish-ai-commit",
  "scripts": {
    "build": "tsc -p ./",
    "compile": "tsc -p ./",
    "check-types": "tsc -p ./ --noEmit",
    "clean": "rimraf ../out/shared",
    "watch": "tsc -p ./ --watch"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "rimraf": "^6.0.1"
  }
}
