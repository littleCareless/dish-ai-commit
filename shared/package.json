{
  "name": "@dish-ai-commit/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared types and utilities for dish-ai-commit",
  "scripts": {
    "build": "tsc -p ./",
    "compile": "tsc -p ./",
    "check-types": "tsc -p ./ --noEmit",
    "clean": "rimraf ../out/shared",
    "watch": "tsc -p ./ --watch"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "8.57.2"
  }
}
